+// Krysta 动效节点 (2026-11-07): fonts added at run time, so a Chinese build can keep most of its faces
+// out of the wasm and the page loads only the ones a project uses (krysta/patch/runtime-fonts.patch).
+#[wasm_bindgen(module = "/js/host.js")]
+extern "C" {
+    #[wasm_bindgen(js_name = krystaFontAdded)]
+    fn krysta_font_added(bytes: &js_sys::Uint8Array);
+}
+
+/// The faces `add_font_data` registered: `[{family, style}]`.
+fn added_faces(ids: &[effectcraft_engine::text::fonts::FaceId]) -> Value {
+    Value::Array(
+        ids.iter()
+            .map(|&id| {
+                let face = effectcraft_engine::text::fonts::face(id);
+                json!({"family": face.info.family, "style": face.info.style})
+            })
+            .collect(),
+    )
+}
+
+/// Register a font (TrueType / OpenType bytes) with the page's engine and every render worker
+/// (present and future), then drop the memory caches so text laid out with a fallback face is laid
+/// out again. Resolves with the faces added: `[{family, style}]` (empty when the bytes are no font).
+#[wasm_bindgen(js_name = addFont)]
+pub fn add_font(data: js_sys::Uint8Array) -> js_sys::Promise {
+    let ids = effectcraft_engine::text::fonts::add_font_data(data.to_vec());
+    if !ids.is_empty() {
+        krysta_font_added(&data);
+    }
+    let faces = added_faces(&ids);
+    js_sys::Promise::new(&mut |resolve, _reject| {
+        let faces = faces.clone();
+        crate::post(move |app| {
+            let _ = app.session.execute("edit.purge", json!({"what": "memory"}));
+            let _ = resolve.call1(&JsValue::NULL, &to_js(&faces));
+        });
+        crate::repaint();
+    })
+}
+
+/// The same inside a render worker (`worker.js`, message `font`): register only, no broadcast.
+#[wasm_bindgen(js_name = workerFont)]
+pub fn worker_font(data: js_sys::Uint8Array) -> JsValue {
+    to_js(&added_faces(&effectcraft_engine::text::fonts::add_font_data(data.to_vec())))
+}
+
