+const krystaFonts = [];
+
+function krystaSendFonts(worker) {
+  for (const bytes of krystaFonts) worker.postMessage({ type: "font", bytes });
+}
+
+/// Called by `addFont` on the page (src/api.rs) after the page's own engine registered the font.
+export function krystaFontAdded(bytes) {
+  const copy = new Uint8Array(bytes);
+  krystaFonts.push(copy);
+  for (const w of idle) w.worker.postMessage({ type: "font", bytes: copy });
+  for (const w of running.values()) w.worker.postMessage({ type: "font", bytes: copy });
+  for (const worker of frameWorkers) if (worker) worker.postMessage({ type: "font", bytes: copy });
+}
