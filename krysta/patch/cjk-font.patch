+/// Chinese faces for the browser, which cannot scan system font folders (Krysta 动效节点, 2026-11-07;
+/// the fallback idea is upstream PR #1621's). All SIL OFL 1.1 or Apache-2.0, see assets/fonts/*-OFL.txt
+/// and NOTICE-Droid.txt. Order matters: the first face that covers a character is its fallback, so
+/// Noto Sans SC Regular draws Chinese in a font without it; Droid Sans Fallback comes last for kana,
+/// Hangul and anything the Chinese fonts lack.
+#[cfg(target_arch = "wasm32")]
+pub static WEB_CJK_FACES: &[&[u8]] = &[
+    include_bytes!("../../../assets/fonts/NotoSansSC-Regular.otf"),
+    include_bytes!("../../../assets/fonts/NotoSansSC-Medium.otf"),
+    include_bytes!("../../../assets/fonts/NotoSansSC-Bold.otf"),
+    include_bytes!("../../../assets/fonts/NotoSansSC-Black.otf"),
+    include_bytes!("../../../assets/fonts/NotoSerifSC-Regular.otf"),
+    include_bytes!("../../../assets/fonts/NotoSerifSC-Bold.otf"),
+    include_bytes!("../../../assets/fonts/LXGWWenKai-Regular.ttf"),
+    include_bytes!("../../../assets/fonts/LXGWWenKai-Medium.ttf"),
+    include_bytes!("../../../assets/fonts/MaShanZheng-Regular.ttf"),
+    include_bytes!("../../../assets/fonts/SmileySans-Oblique.ttf"),
+    include_bytes!("../../../assets/fonts/ZCOOLKuaiLe-Regular.ttf"),
+    WEB_CJK_FALLBACK,
+];
+/// The interface's own fallback face (egui): Droid Sans Fallback, small and with kana and Hangul.
+#[cfg(target_arch = "wasm32")]
+pub static WEB_CJK_FALLBACK: &[u8] = include_bytes!("../../../assets/fonts/DroidSansFallback.ttf");
+
 /// The default family for new text.
 pub const DEFAULT_FAMILY: &str = "Inter";
 
@@ -327,6 +351,12 @@ fn db() -> &'static RwLock<Db> {
                 push(&mut db, info_from(n, FaceData::Static(b), "bundled"));
             }
         }
+        #[cfg(target_arch = "wasm32")]
+        for b in WEB_CJK_FACES.iter().copied() {
+            for n in read_faces_bytes(b) {
+                push(&mut db, info_from(n, FaceData::Static(b), "bundled"));
+            }
+        }
         RwLock::new(db)
     })
 }
