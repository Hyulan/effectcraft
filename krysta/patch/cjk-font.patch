+// Krysta 动效节点 (2026-11-07): Chinese faces for the browser build, which cannot scan system font
+// folders (upstream #1445; the fallback idea is PR #1621's). The list is written at build time from
+// krysta/fonts/fonts.txt in the Krysta fork (krysta-zh-web.yml): WEB_CJK_FACES in that order (the first
+// face covering a character is its fallback, so the first line is the default Chinese face) and
+// WEB_CJK_FALLBACK (Droid Sans Fallback, for the interface and kana / Hangul). Licences: fonts-licenses/.
+include!("krysta_web_fonts.rs");
+
 /// The default family for new text.
 pub const DEFAULT_FAMILY: &str = "Inter";
 
@@ -327,6 +334,12 @@ fn db() -> &'static RwLock<Db> {
